---
import type { Color } from "../config/colores";
import { colores } from "../config/colores";

interface Props {
  encabezados: string[];
  filas: (string | number)[][];
  acento?: Color;
}

const { encabezados, filas, acento = "verde" } = Astro.props;
---

<div>
  <table>
    <thead>
      <tr>{encabezados.map((encabezado) => <th>{encabezado}</th>)}</tr>
    </thead>
    <tbody>
      {filas.map((fila) => <tr>{fila.map((celda) => <td>{celda}</td>)}</tr>)}
    </tbody>
  </table>
</div>

<style define:vars={{ acento: colores[acento] }}>
  div {
    width: fit-content;
    max-width: 100%;
    margin: 1.5rem auto;
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--gris);
    background: var(--blanco);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  }

  table {
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.6rem 1.5rem;
    text-align: center;
    border-bottom: 1px solid var(--gris);
  }

  th {
    background-color: var(--acento);
    color: var(--blanco);
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody tr:hover {
    background-color: var(--crema);
  }
</style>

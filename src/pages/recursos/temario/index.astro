---
import Layout from "../../../layouts/Layout.astro";
import Tarjeta from "../../../components/Tarjeta.astro";
import Seccion from "../../../components/Seccion.astro";
import Etiqueta from "../../../components/Etiqueta.astro";
import type { Color } from "../../config/colores";

export const titulo = "Temario";

const TemarioId = "1Q0VMG1B-K8dH6GiVGIQFHtt_pZ4R-_Un";
const TemarioUrl = `https://drive.google.com/uc?export=download&id=${TemarioId}`;

interface Recurso {
  ruta: string;
  titulo: string;
  descripcion: string;
  disponible: boolean;
}

// Buscamos todos los archivos .astro en esta carpeta
// NOTA: los archivos, menos este, tiene un numero N_tema.astro para
// ordenarlos cuando se lean.
const todosAstros = Object.entries(
  import.meta.glob("./*.astro", { eager: true }),
);

// Filtramos y armamos la lista de temas
const temas = todosAstros.flatMap(([ruta, archivo]) => {
  const modulo = archivo as Record<string, any>;
  if (ruta.includes("index.astro")) return [];

  // Omitimos si a algún archivo se le olvidó poner titulo o descripcion
  if (!modulo.titulo || !modulo.descripcion) return [];

  return [
    {
      // Limpiamos la ruta
      ruta: "/recursos/temario" + ruta.replace(".", "").replace(".astro", ""),
      titulo: modulo.titulo,
      descripcion: modulo.descripcion,
      subtemas: modulo.subtemas || [],
      disponible: modulo.disponible,
    },
  ];
});
---

<Layout formulas={true}>
  <main class="contenedor-temario">
    <header class="cabecera motion-fadein">
      <h1>{titulo}</h1>
    </header>

    <section class="grid-temas motion-fadein">
      {
        temas.map((bloque) => (
          <div class="tema-link">
            <Tarjeta
              href={bloque.disponible ? bloque.ruta : undefined}
              data-astro-prefetch
              titulo={bloque.titulo}
              colorTitulo="negro"
              acento={bloque.disponible ? "cremaOscuro" : "gris"}
              hover={bloque.disponible}
            >
              <div class="cabecera-tarjeta"></div>
              <p class="descripcion-tema">{bloque.descripcion}</p>

              <ul>
                {bloque.subtemas.map((subtema: string) => (
                  <li>{subtema}</li>
                ))}
              </ul>
            </Tarjeta>
          </div>
        ))
      }
    </section>

    <div class="descarga">
      <Seccion
        titulo="¿Prefieres estudiarlo sin conexión?"
        alineacion="izquierda"
      >
        <p>Descarga el documento completo</p>
      </Seccion>
      <Etiqueta href={TemarioUrl} colorFondo="naranja"
        >Descargar Temario en PDF &darr;</Etiqueta
      >
    </div>
  </main>
</Layout>

<style>
  .cabecera {
    text-align: center;
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  h2 {
    color: var(--azulUaslp);
  }

  .tema-link {
    text-decoration: none;
    color: inherit;
    display: flex;
  }

  .tema-link > * {
    flex-grow: 1;
  }

  .grid-temas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 6rem;
  }

  .descripcion-tema {
    color: var(--negro);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    font-style: italic;
  }

  .descarga {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  /* Responsive */
  @media (max-width: 780px) {
    .descarga {
      flex-direction: column;
    }
  }
</style>

---
import Formulas from "../components/Formulas.astro";
import Layout from "../layouts/Layout.astro";
import Etiqueta from "../components/Etiqueta.astro";

interface Props {
  formulas?: boolean;
  latex?: boolean;
  InfografiaId: string;
  ProblemasId: string;
  SolucionarioId: string;
}
const {
  formulas = true,
  latex = false,
  InfografiaId,
  ProblemasId,
  SolucionarioId,
} = Astro.props;

const downloadUrl = (id: string) =>
  `https://drive.google.com/uc?export=download&id=${id}`;
---

<Layout>
  {
    latex && (
      <>
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
        />
        <script
          is:inline
          defer
          src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"
        />
        <script
          is:inline
          defer
          src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
          onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}]});"
        />
      </>
    )
  }
  {formulas && <Formulas />}
  <main class="contenedor-tema">
  <slot />
  </main>
  <Etiqueta href={downloadUrl(InfografiaId)}>Descarga la Infografia</Etiqueta>
  <Etiqueta href={downloadUrl(ProblemasId)}>Descarga Problemas</Etiqueta>
  <Etiqueta href={downloadUrl(SolucionarioId)}
    >Descarga Problemas Resueltos</Etiqueta
  >
</Layout>

<style>
  .contenedor-tema {
    padding: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }
</style>
